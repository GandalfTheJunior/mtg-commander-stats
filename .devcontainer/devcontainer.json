{
  "name": "MTG Commander Stats iPhone preview",
  "image": "mcr.microsoft.com/devcontainers/java:25-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "24"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:4": {}
  },
  "remoteUser": "vscode",
  "forwardPorts": [
    5173,
    5174
  ],
  "portsAttributes": {
    "5173": {
      "label": "MTG Commander Stats (iPhone)",
      "onAutoForward": "notify",
      "protocol": "http"
    },
    "5174": {
      "label": "MTG Commander Stats (Status)",
      "onAutoForward": "notify",
      "protocol": "http"
    },
    "5432": {
      "onAutoForward": "ignore"
    },
    "8080": {
      "onAutoForward": "ignore"
    }
  },
  "postStartCommand": "bash .devcontainer/start.sh"
}
